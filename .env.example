# MeetMind AI Environment Variables (Production & Development)

# Active Web Server & Frontend (TanStack Start / Nitro / Vercel)
PORT=3000
NODE_ENV=production
# Leave VITE_API_URL unset for same-origin (/api/v1) in production, or set your public HTTPS API origin
VITE_API_URL=/api/v1
PUBLIC_APP_URL=https://meetmind-atlas.vercel.app

# Pipeline Routing Mode:
# "auto" (Recommended): Direct Backend -> AssemblyAI -> Single Unified Gemini JSON when ASSEMBLYAI_API_KEY is set (lowest latency + instant progressive transcript), otherwise n8n if configured, otherwise parallel built-in Whisper.
# "direct": Force Direct Backend -> AssemblyAI -> Gemini (bypassing n8n hop)
# "n8n": Force n8n webhook orchestration when N8N_WEBHOOK_URL is set
PIPELINE_MODE=auto

# n8n AI Workflow Integration (Server-side Only — NEVER hardcode localhost:5678 in frontend)
# Development: http://localhost:5678/webhook/meeting-upload
# Production (Vercel): https://your-hosted-n8n-domain.com/webhook/meeting-upload
N8N_WEBHOOK_URL=
N8N_WEBHOOK_API_KEY=
N8N_WEBHOOK_AUTH_HEADER=X-N8N-API-Key
N8N_TIMEOUT_MS=180000
# Optional non-blocking post-completion automation webhook (fires asynchronously after DB save, zero user latency)
N8N_POST_COMPLETE_WEBHOOK_URL=
# Set to "true" to automatically fall back to direct AssemblyAI/Gemini/Whisper when n8n is unreachable
N8N_FALLBACK_TO_DIRECT=false

# AssemblyAI Real Speech-to-Text & Speaker Diarization (Server-side Only)
ASSEMBLYAI_API_KEY=
# Highest-accuracy verified Arabic + multilingual model chain (comma-separated)
ASSEMBLYAI_SPEECH_MODELS=assemblyai-stt-3-7,universal-2
ASSEMBLYAI_SPEAKER_LABELS=true
# Keep strict dedicated AssemblyAI accuracy when ASSEMBLYAI_API_KEY is set (never silently degrade to low-accuracy fallback)
ASSEMBLYAI_ALLOW_LOCAL_FALLBACK=false
# Optional explicit HTTPS webhook URL for zero-polling instant callback (auto-derived from PUBLIC_APP_URL/VERCEL_URL when unset)
ASSEMBLYAI_WEBHOOK_URL=
ASSEMBLYAI_WEBHOOK_SECRET=

# Local Built-in Multi-Worker Whisper ONNX Fallback Tuning (used ONLY when AssemblyAI & n8n are unconfigured)
# LOCAL_WHISPER_WORKERS=2
# LOCAL_WHISPER_MODEL=Xenova/whisper-small

# Gemini Multimodal AI & Speech Engine (Server-side Only)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite
GEMINI_CHAT_MODEL=gemini-3.5-flash
GEMINI_CHAT_FALLBACK_MODEL=gemini-3.5-flash-lite
GEMINI_ASR_MODEL=gemini-3.5-transcribe
GEMINI_ASR_FALLBACK_MODEL=gemini-3.5-flash
GEMINI_MAX_RETRIES=3
GEMINI_RETRY_BASE_DELAY_MS=1000
GEMINI_RETRY_MAX_DELAY_MS=8000

# Authentication & Session Security (Server-side Only)
JWT_SECRET=
SESSION_SECRET=

# Database & Vercel Persistent Storage (Server-side Only)
# Optional Vercel KV / Upstash Redis for multi-instance persistence:
KV_REST_API_URL=
KV_REST_API_TOKEN=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Optional relational database connection:
DATABASE_URL=

# Allowed Hosts (Vite / Nitro preview)
# Optional comma-separated additional hostnames (e.g. your-custom-domain.com)
VITE_ALLOWED_HOSTS=

# Storage & Media Pipeline Limits
MEETMIND_DATA_DIR=
RECORDINGS_STORAGE_PATH=
CHUNKS_STORAGE_PATH=
MAX_RECORDING_SIZE_MB=500
